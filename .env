# Copy this file to .env for local testing. .env is never read in a way
# that reaches AWS — in ECS these same variable names are just set as
# regular task environment variables instead.

APP_ENV=local

# Salesforce credentials for local configuration.
# Replace these placeholders in your private .env file; never commit real credentials.
SF_AUTH_METHOD=password
SF_USERNAME=your-salesforce-username
SF_PASSWORD=your-salesforce-password
SF_SECURITY_TOKEN=your-salesforce-security-token
SF_DOMAIN=login

# For OAuth client credentials instead, use this block and remove/comment out
# the username/password fields above:
# SF_AUTH_METHOD=client_credentials
# SF_CLIENT_ID=your-connected-app-consumer-key
# SF_CLIENT_SECRET=your-connected-app-consumer-secret
# SF_DOMAIN=login

# Only needed if you want to test S3 upload or Secrets Manager loading
# locally too (requires your AWS CLI credentials to be configured).
AWS_REGION=us-east-1
S3_BUCKET=
SECRETS_PREFIX=cpq-extractor/
