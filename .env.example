# Copy this file to .env for local testing. .env is never read in a way
# that reaches AWS — in ECS these same variable names are just set as
# regular task environment variables instead.

APP_ENV=local

# Salesforce credentials for local configuration.
# Replace these placeholders in your private .env file; never commit real credentials.
SF_AUTH_METHOD=password
SF_USERNAME=your-salesforce-username
SF_PASSWORD=your-salesforce-password
SF_SECURITY_TOKEN=your-salesforce-security-token
SF_DOMAIN=login

# Include inactive products in extraction output (default: false).
CPQ_INCLUDE_INACTIVE_RECORDS=false

# For OAuth client credentials instead, use this block and remove/comment out
# the username/password fields above:
# SF_AUTH_METHOD=client_credentials
# SF_CLIENT_ID=your-connected-app-consumer-key
# SF_CLIENT_SECRET=your-connected-app-consumer-secret
# SF_DOMAIN=login

# Only needed if you want to test S3 upload or Secrets Manager loading
# locally too (requires your AWS CLI credentials to be configured).
AWS_REGION=us-east-1
S3_BUCKET=
SECRETS_PREFIX=cpq-extractor/

# ---------------------------------------------------------------------------
# LLM configuration for client document generation (run_document.py)
# ---------------------------------------------------------------------------

# Which provider to use for the .docx generation pipeline.
# One of: mock | gemini | anthropic | bedrock
# "mock" is fully offline and deterministic — no API key required.
LLM_PROVIDER=mock

# API key for the selected provider. LLM_API_KEY works as a provider-agnostic
# fallback; the provider-specific keys take precedence when both are set.
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_API_KEY=

# Separate models for the two pipeline stages (cheaper model for the many
# per-packet analysis calls, stronger model for the narrative synthesis calls).
# Free-tier options:
#   gemini-3.8-flash        GA, free tier, best quality    (recommended)
#   gemini-3.5-flash-lite   GA, free tier, cheapest
#   gemini-3-flash-preview  free tier but PREVIEW: more restrictive rate
#                           limits, deprecated with >=2 weeks notice
LLM_MODEL_ANALYSIS=gemini-3.8-flash
LLM_MODEL_SYNTHESIS=gemini-3.8-flash

# Max parallel LLM requests during the analysis phase. Lower this if you hit
# provider rate limits (HTTP 429).
LLM_CONCURRENCY=4

# Include exact prices and cost records in the LLM input packets.
# Leave false for client-shareable documents (sensitive + noisy).
LLM_INCLUDE_PRICES=false

# Include email addresses in LLM input packets. Keep false unless explicitly needed.
LLM_INCLUDE_PERSONAL_DATA=false

# Scale controls for packet construction (guards against oversized prompts).
MAX_BUNDLE_PACKETS=200
MAX_RULE_PACKETS=50
MAX_PACKET_TOKENS=3500
